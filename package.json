{
  "name": "agents-everywhere-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for the Agents, Everywhere: Bots, Channels & More global hackathon.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/channel",
    "apps/speech-gateway",
    "apps/web",
    "apps/companion"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:slack": "npm run dev --workspace channel",
    "dev:speech": "npm run dev --workspace speech-gateway",
    "channel:status": "npx copilotkit@latest channels status --json",
    "channel:setup": "npx copilotkit@latest channels setup",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev --workspace web",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm test",
    "companion": "npm run start --workspace companion --",
    "companion:build": "npm run build:native --workspace companion",
    "companion:demo": "npm run demo-relay --workspace companion --",
    "companion:install": "npm run install:app --workspace companion",
    "companion:check-app": "npm run test:bundle --workspace companion"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
