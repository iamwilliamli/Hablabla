# Hablabla local inference needs no model API key.
# The following model settings are only for the inherited reference/Slack/voice apps.
MODEL_PROVIDER=openai
MODEL=gpt-5.6-sol
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENROUTER_API_KEY=

# Web follow-up persistence (optional until using workplace records).
AMBIGUOUS_API_KEY=
WEB_APPROVAL_DIR=.data/web-approvals

# Slack only; configure through the documented Channels setup workflow.
CHANNEL_CODE=
INTELLIGENCE_API_KEY=
EXA_API_KEY=
# Public speech gateway. Keep API keys server-side; never expose them through
# NEXT_PUBLIC_* variables or browser bundles.
# The web proxy accepts these dedicated values. When they are omitted in the
# same checkout, it uses the gateway host/port and the first API_KEYS entry.
HABLABLA_SPEECH_URL=http://127.0.0.1:8765
HABLABLA_SPEECH_API_KEY=replace-with-a-long-random-partner-key
HABLABLA_SPEECH_HOST=127.0.0.1
HABLABLA_SPEECH_PORT=8765
HABLABLA_SPEECH_PUBLIC_URL=https://speech.example.com
HABLABLA_SPEECH_API_KEYS=replace-with-a-long-random-partner-key
HABLABLA_SPEECH_ALLOWED_ORIGINS=http://localhost:3100,https://partner.example.com
HABLABLA_SPEECH_WORKER=./apps/macos-model-worker/.xcode-derived/Build/Products/Release/hablabla-model-worker
HABLABLA_FFMPEG=/opt/homebrew/bin/ffmpeg
HABLABLA_SPEECH_MAX_UPLOAD_BYTES=209715200
# Optional existing model directories. Leave unset to use publisher downloads.
# HABLABLA_PARAKEET_MODEL_DIR=/absolute/path/to/parakeet-tdt-0.6b-v3-coreml
# FluidAudio multilingual export, including metadata.json, tokenizer.json and logits decoder assets.
# HABLABLA_NEMOTRON_MODEL_DIR=/absolute/path/to/nemotron-multilingual-coreml
# HABLABLA_MOSS_MODEL_DIR=/absolute/path/to/mlx-MOSS-Transcribe-Diarize-4bit
